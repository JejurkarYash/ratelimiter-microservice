generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  plan      String     @default("free")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  apiKeys   ApiKey[]
  rules     Rule[]
  usageLogs UsageLog[]
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  tenantId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model Rule {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  limit     Int
  window    Int
  algorithm Algorithm @default(FIXED_WINDOW)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
}

model UsageLog {
  id         String   @id @default(uuid())
  identifier String
  rule       String
  allowed    Boolean
  count      Int
  tenantId   String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

enum Algorithm {
  FIXED_WINDOW
  SLIDING_WINDOW
}
