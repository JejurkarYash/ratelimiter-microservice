{
   "name": "@throttlr/sdk",
   "version": "1.0.0",
   "description": "Rate Limiting SDK For Throttlr",
   "main": "./dist/index.js",
   "module": "./dist/index.mjs",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "require": "./dist/index.js",
         "import": "./dist/index.mjs"
      }
   },
   "files": [
      "dist"
   ],
   "scripts": {
      "build": "tsup src/index.ts --format cjs,esm --dts --clean",
      "start": "node dist/index.js"
   },
   "keywords": [],
   "author": "",
   "license": "ISC",
   "devDependencies": {
      "@types/node": "^22.15.3",
      "tsup": "^8.5.1",
      "typescript": "^5.9.3"
   },
   "dependencies": {
      "@types/express": "^5.0.6",
      "express": "^5.2.1"
   }
}